#pragma once

#include <iostream>
#include <string>

#define RWKV_LIGHTNING_VERSION "@RWKV_LIGHTNING_VERSION@"

namespace rwkv {

inline bool is_version_flag(const std::string &arg) {
  return arg == "--version" || arg == "-v";
}

// One line, "<program> <version>", so scripts can split on the space.
inline int print_version(const char *program) {
  std::cout << program << ' ' << RWKV_LIGHTNING_VERSION << std::endl;
  return 0;
}

